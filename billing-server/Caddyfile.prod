{
    email admin@stealthy.co.in
    servers {
        trusted_proxies static private_ranges
    }

}

# Automatically obtains Let's Encrypt cert and forces HTTPS
api.stealthy.co.in {
    # Request access logs
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 3
            roll_keep_for 30d
        }
        format json
    }


    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        -Server
    }

    # Restrict sensitive endpoints entirely from public ingress.
    # Internal networks (Docker/WireGuard) should access billing-api:8080 directly.
    @protected {
        path /readyz /admin/*
    }
    respond @protected "403 Forbidden" 403 {
        close
    }

    # Reverse proxy to Billing API over Docker internal network
    reverse_proxy billing-api:8080
}
