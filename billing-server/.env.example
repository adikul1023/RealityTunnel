# ── App ────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Individual components (recommended — compose the URL in config.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=changeme

# Alternatively, set a full URL (takes precedence if set)
# DATABASE_URL=postgresql+asyncpg://billing:changeme@localhost:5432/billing

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Security ────────────────────────────────────────────────────────────────
# MUST be changed before deploying to any non-local environment.
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
