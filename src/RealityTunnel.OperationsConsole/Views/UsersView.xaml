<UserControl x:Class="RealityTunnel.OperationsConsole.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RealityTunnel.OperationsConsole.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusColorConverter x:Key="StatusColor" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter & Search Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search by Account ID or UUID..." Icon="{ui:SymbolIcon Search24}"/>

            <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedStatusFilter}" SelectedValuePath="Content" Height="36" VerticalContentAlignment="Center">
                <ComboBoxItem Content="ALL" IsSelected="True"/>
                <ComboBoxItem Content="ACTIVE"/>
                <ComboBoxItem Content="SUSPENDED"/>
                <ComboBoxItem Content="EXPIRED"/>
            </ComboBox>

            <ui:Button Grid.Column="4" Content="Filter / Search" Appearance="Primary" Icon="{ui:SymbolIcon Filter24}" Command="{Binding SearchCommand}" Height="36"/>

            <ui:Button Grid.Column="6" Content="Refresh List" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding LoadAccountsCommand}" Height="36"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" Background="#111827" BorderBrush="#1F2937" BorderThickness="1"
                  RowBackground="Transparent" AlternatingRowBackground="#0D121F" Foreground="White" FontSize="13" SelectionMode="Single"
                  SelectedItem="{Binding SelectedAccount}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ACCOUNT ID" Binding="{Binding AccountId}" Width="160" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="SYSTEM UUID" Binding="{Binding Id}" Width="260" Foreground="#9CA3AF"/>
                
                <!-- Status Badge -->
                <DataGridTemplateColumn Header="STATUS" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusColor}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="PLAN ID" Binding="{Binding PlanId}" Width="140" Foreground="#60A5FA"/>
                <DataGridTextColumn Header="EXPIRES AT" Binding="{Binding FormattedExpiry}" Width="160" Foreground="#D1D5DB"/>
                <DataGridTextColumn Header="CREATED AT" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="160" Foreground="#6B7280"/>

                <!-- Action Column -->
                <DataGridTemplateColumn Header="ACTIONS" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Inspect Detail" Appearance="Secondary" Height="28" Padding="12,2" FontSize="12"
                                       Command="{Binding DataContext.InspectAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                       CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination Footer -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1,0,1,1" Padding="16,12" CornerRadius="0,0,8,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Customer Records:" Foreground="#9CA3AF" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Previous Page" Appearance="Secondary" Command="{Binding PreviousPageCommand}" Height="32" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0}'}" VerticalAlignment="Center" Foreground="#D1D5DB" Margin="8,0,16,0" FontWeight="SemiBold"/>
                    <ui:Button Content="Next Page" Appearance="Secondary" Command="{Binding NextPageCommand}" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Spinner -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
