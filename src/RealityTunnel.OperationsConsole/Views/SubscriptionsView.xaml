<UserControl x:Class="RealityTunnel.OperationsConsole.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RealityTunnel.OperationsConsole.Converters"
             x:Name="SubscriptionsRoot">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusColorConverter x:Key="StatusColor" />
        <conv:StringInSetToVisibilityConverter x:Key="StatusInSetVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter by Status:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox SelectedValue="{Binding SelectedStatusFilter}" SelectedValuePath="Content" Width="150" Height="32" Margin="0,0,12,0">
                    <ComboBoxItem Content="ALL" IsSelected="True"/>
                    <ComboBoxItem Content="active"/>
                    <ComboBoxItem Content="expired"/>
                    <ComboBoxItem Content="grace"/>
                </ComboBox>
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding LoadSubscriptionsCommand}" Appearance="Secondary" Height="32"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Total:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TotalCount}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Data Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Subscriptions}" AutoGenerateColumns="False" CanUserAddRows="False" 
                  HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="None" RowHeight="56"
                  Background="Transparent" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#1F2937">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SUBSCRIPTION ID" Binding="{Binding Id}" Width="250" FontWeight="SemiBold"/>
                
                <DataGridTemplateColumn Header="STATUS" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#374151" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusColor}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="DATA USED / LIMIT (BYTES)" Binding="{Binding DataUsedBytes, StringFormat='{}{0:N0} B'}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#34D399"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="EXPIRES AT" Binding="{Binding ExpiresAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D1D5DB"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Action Toolbar per row - context aware by status -->
                <DataGridTemplateColumn Header="SUPER-ADMIN CONTROLS" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsSuperAdmin, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource BoolToVis}}">

                                <!-- ACTIVE: Edit Plan, Grace, Revoke, Expire -->
                                <ComboBox ItemsSource="{Binding DataContext.AvailablePlans, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          SelectedValue="{Binding SelectedPlanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=active}"
                                          Width="120" Height="26" Margin="0,0,4,0" FontSize="11" Padding="4,2"/>
                                <ui:Button Content="Update Plan" Appearance="Primary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           IsEnabled="{Binding IsPlanChanged}"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=active}"
                                           Command="{Binding DataContext.EditPlanCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Grace (7d)" Appearance="Secondary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=active}"
                                           Command="{Binding DataContext.GraceCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Expire" Appearance="Danger" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=active}"
                                           Command="{Binding DataContext.ExpireCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Revoke" Appearance="Danger" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=active}"
                                           Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>

                                <!-- GRACE: Activate, Expire -->
                                <ui:Button Content="Activate" Appearance="Primary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=grace}"
                                           Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Expire" Appearance="Danger" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=grace}"
                                           Command="{Binding DataContext.ExpireCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>

                                <!-- EXPIRED: Renew (+30d), Activate -->
                                <ui:Button Content="Renew (+30d)" Appearance="Primary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=expired}"
                                           Command="{Binding DataContext.RenewCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Activate" Appearance="Secondary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=expired}"
                                           Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>

                                <!-- REVOKED: Activate only -->
                                <ui:Button Content="Activate" Appearance="Primary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=revoked}"
                                           Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>

                                <!-- CANCELLED: Renew only -->
                                <ui:Button Content="Renew (+30d)" Appearance="Secondary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Visibility="{Binding Status, Converter={StaticResource StatusInSetVis}, ConverterParameter=cancelled}"
                                           Command="{Binding DataContext.RenewCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Spinner -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
