<UserControl x:Class="RealityTunnel.OperationsConsole.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RealityTunnel.OperationsConsole.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusColorConverter x:Key="StatusColor" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter by Status:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox SelectedValue="{Binding SelectedStatusFilter}" SelectedValuePath="Content" Width="150" Height="36" Margin="0,0,12,0">
                    <ComboBoxItem Content="ALL" IsSelected="True"/>
                    <ComboBoxItem Content="active"/>
                    <ComboBoxItem Content="expired"/>
                    <ComboBoxItem Content="grace"/>
                </ComboBox>
                <ui:Button Content="Apply Filter" Appearance="Primary" Icon="{ui:SymbolIcon Filter24}" Command="{Binding LoadSubscriptionsCommand}" Height="36"/>
            </StackPanel>

            <ui:Button Content="Refresh List" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding LoadSubscriptionsCommand}" HorizontalAlignment="Right" Height="36"/>
        </Grid>

        <!-- Subscriptions DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Subscriptions}" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" Background="#111827" BorderBrush="#1F2937" BorderThickness="1"
                  RowBackground="Transparent" AlternatingRowBackground="#0D121F" Foreground="White" FontSize="13"
                  SelectedItem="{Binding SelectedSubscription}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SUBSCRIPTION UUID" Binding="{Binding Id}" Width="240" FontWeight="SemiBold" Foreground="#60A5FA"/>
                <DataGridTextColumn Header="ACCOUNT UUID" Binding="{Binding AccountId}" Width="240" Foreground="#9CA3AF"/>
                <DataGridTextColumn Header="PLAN" Binding="{Binding Plan}" Width="120" FontWeight="SemiBold" Foreground="#D1D5DB"/>

                <DataGridTemplateColumn Header="STATUS" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusColor}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="DATA USED / LIMIT (BYTES)" Binding="{Binding DataUsedBytes, StringFormat='{}{0:N0} B'}" Width="180" Foreground="#34D399"/>
                <DataGridTextColumn Header="EXPIRES AT" Binding="{Binding ExpiresAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="150" Foreground="#D1D5DB"/>

                <!-- Action Toolbar per row -->
                <DataGridTemplateColumn Header="SUPER-ADMIN CONTROLS" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsSuperAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                <ui:Button Content="Activate" Appearance="Primary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Grace (7d)" Appearance="Secondary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Command="{Binding DataContext.GraceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Renew (+30d)" Appearance="Secondary" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Command="{Binding DataContext.RenewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Expire" Appearance="Danger" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                           Command="{Binding DataContext.ExpireCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                                <ui:Button Content="Cancel" Appearance="Danger" Height="26" Padding="8,1" FontSize="11"
                                           Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Spinner -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
