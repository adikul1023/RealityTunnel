<UserControl x:Class="RealityTunnel.OperationsConsole.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Missing Endpoint Banner -->
        <Border Grid.Row="0" Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="28" Foreground="#EF4444" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="Backend Support Required (Missing Endpoint Identified in Step 0 Audit)" FontSize="15" FontWeight="Bold" Foreground="#FECACA"/>
                    <TextBlock Text="The administrative log streaming and query endpoint ('GET /api/admin/logs') is not currently exposed by the backend billing server. Log viewer controls are disabled in Phase 1."
                               FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search & Filter Controls (Disabled) -->
        <Grid Grid.Row="1" Margin="0,0,0,16" IsEnabled="{Binding CanQueryLogs}" ToolTip="{Binding DisabledTooltip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search logs by keyword or UUID..." Icon="{ui:SymbolIcon Search24}"/>
            <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedSeverity}" SelectedValuePath="Content" Height="36">
                <ComboBoxItem Content="ALL" IsSelected="True"/>
                <ComboBoxItem Content="INFO"/>
                <ComboBoxItem Content="WARN"/>
                <ComboBoxItem Content="ERROR"/>
            </ComboBox>
            <ui:Button Grid.Column="4" Content="Query Logs" Appearance="Primary" Icon="{ui:SymbolIcon DocumentSearch24}" Command="{Binding SearchLogsCommand}" Height="36"/>
        </Grid>

        <!-- Dummy Log Grid area -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DocumentText24" FontSize="64" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Log stream currently disconnected." FontSize="16" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                <TextBlock Text="Check MissingEndpoints.md for implementation roadmap." FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Pagination Footer (Disabled) -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1,0,1,1" Padding="16,12" CornerRadius="0,0,8,8"
                IsEnabled="{Binding CanQueryLogs}" ToolTip="{Binding DisabledTooltip}">
            <Grid>
                <TextBlock Text="Total Log Events: 0" Foreground="#6B7280" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Previous Page" Appearance="Secondary" IsEnabled="False" Height="32" Margin="0,0,8,0"/>
                    <TextBlock Text="Page 1" VerticalAlignment="Center" Foreground="#6B7280" Margin="8,0,16,0"/>
                    <ui:Button Content="Next Page" Appearance="Secondary" IsEnabled="False" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
