<ui:FluentWindow x:Class="RealityTunnel.OperationsConsole.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:conv="clr-namespace:RealityTunnel.OperationsConsole.Converters"
                 Title="RealityTunnel Operations Console (v1.0.0)"
                 Width="1320" Height="840"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1F2937"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="RealityTunnel Operations Console — v1.0.0" Grid.Row="0" Padding="16,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,24">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="28" Foreground="#60A5FA" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="RealityTunnel" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Operations Rail" FontSize="11" Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" x:Name="NavPanel">
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataPie24" FontSize="20" Margin="0,0,12,0" Foreground="#60A5FA"/>
                                <TextBlock Text="Dashboard" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Users" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="20" Margin="0,0,12,0" Foreground="#34D399"/>
                                <TextBlock Text="Users &amp; Accounts" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Subscriptions" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="20" Margin="0,0,12,0" Foreground="#A78BFA"/>
                                <TextBlock Text="Subscriptions" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Billing" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Money24" FontSize="20" Margin="0,0,12,0" Foreground="#FBBF24"/>
                                <TextBlock Text="Billing" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Infrastructure" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Server24" FontSize="20" Margin="0,0,12,0" Foreground="#F87171"/>
                                <TextBlock Text="Infrastructure &amp; Health" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Logs" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="20" Margin="0,0,12,0" Foreground="#9CA3AF"/>
                                <TextBlock Text="Logs Viewer" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="20" Margin="0,0,12,0" Foreground="#9CA3AF"/>
                                <TextBlock Text="Settings &amp; Probes" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer Session Status -->
                    <Border Grid.Row="2" Background="#1F2937" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="PersonCircle24" FontSize="20" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentUsername}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#374151"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuperAdmin}" Value="True">
                                                <Setter Property="Background" Value="#4C1D95"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentRole}" FontSize="10" FontWeight="Bold" Foreground="#DDD6FE"/>
                            </Border>
                            <ui:Button Content="Purge Session &amp; Logout" Appearance="Danger" Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" Height="32"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="#0B0F19">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding CurrentViewTitle}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock Text="Memory JWT Active" FontSize="11" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic View Host -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewContent}" Margin="24"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
