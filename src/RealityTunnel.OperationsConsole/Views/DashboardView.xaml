<UserControl x:Class="RealityTunnel.OperationsConsole.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RealityTunnel.OperationsConsole.Converters">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Action & Status Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Live Operational Metrics" FontSize="16" FontWeight="SemiBold" Foreground="#E5E7EB" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding LastUpdatedFormatted, StringFormat='Updated: {0}'}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:Button Content="Refresh Dashboard" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding LoadDashboardCommand}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- KPI Cards Row 1 -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Active Subscribers -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ACTIVE SUBSCRIBERS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ActiveSubscribers}" FontSize="32" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="Total paying customers" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="36" Foreground="#064E3B" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 2: Online Users -->
            <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ACTIVE SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding OnlineUsers}" FontSize="32" FontWeight="Bold" Foreground="#60A5FA" />
                        <TextBlock Text="Connected to VPN Gateways" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Pulse24" FontSize="36" Foreground="#1E3A8A" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 3: Monthly Revenue Est -->
            <Border Grid.Column="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="EST. MONTHLY REVENUE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding MonthlyRevenueEst, StringFormat='₹{0:N2}'}" FontSize="32" FontWeight="Bold" Foreground="#FBBF24" />
                        <TextBlock Text="Based on active subscriptions" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Money24" FontSize="36" Foreground="#78350F" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 4: Total Registered Devices -->
            <Border Grid.Column="6" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="REGISTERED DEVICES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalDevices}" FontSize="32" FontWeight="Bold" Foreground="#A78BFA" />
                        <TextBlock Text="Across all customer profiles" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="36" Foreground="#4C1D95" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- KPI Cards Row 2 -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 5: Active Subscriptions -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ACTIVE SUBSCRIPTIONS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ActiveSubscriptions}" FontSize="26" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Valid status" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 6: Expired Subscriptions -->
            <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="EXPIRED SUBSCRIPTIONS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ExpiredSubscriptions}" FontSize="26" FontWeight="Bold" Foreground="#EF4444" />
                        <TextBlock Text="Requires renewal or grace" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="DismissCircle24" FontSize="32" Foreground="#991B1B" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 7: Bandwidth Today -->
            <Border Grid.Column="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BANDWIDTH TODAY" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding BandwidthTodayFormatted}" FontSize="26" FontWeight="Bold" Foreground="#34D399" />
                        <TextBlock Text="Traversed across edge nodes" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="ArrowTransfer24" FontSize="32" Foreground="#064E3B" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Card 8: Bandwidth Month -->
            <Border Grid.Column="6" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BANDWIDTH MONTH" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding BandwidthMonthFormatted}" FontSize="26" FontWeight="Bold" Foreground="#60A5FA" />
                        <TextBlock Text="Billing period aggregate" FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ui:SymbolIcon Symbol="DataUsage24" FontSize="32" Foreground="#1E3A8A" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Spinner overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
