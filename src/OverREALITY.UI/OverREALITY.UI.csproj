<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverREALITY.Shared\OverREALITY.Shared.csproj" />
    <ProjectReference Include="..\OverREALITY.Core\OverREALITY.Core.csproj" />
    <ProjectReference Include="..\OverREALITY.Infrastructure\OverREALITY.Infrastructure.csproj" />
    <ProjectReference Include="..\OverREALITY.Configuration\OverREALITY.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Obfuscar" Version="2.2.38" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="environment.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <Target Name="Obfuscate" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="$(Obfuscar) obfuscar.xml" WorkingDirectory="$(ProjectDir)" />
    <!-- Copy obfuscated files back to publish folder so Inno Setup picks them up -->
    <ItemGroup>
      <ObfuscatedFiles Include="bin\Release\net8.0-windows\win-x64\publish_obfuscated\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ObfuscatedFiles)" DestinationFolder="bin\Release\net8.0-windows\win-x64\publish" />
  </Target>
</Project>
