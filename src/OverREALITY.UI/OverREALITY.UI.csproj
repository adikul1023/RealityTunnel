    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OverREALITY.Shared\OverREALITY.Shared.csproj" />
    <ProjectReference Include="..\OverREALITY.Core\OverREALITY.Core.csproj" />
