<UserControl x:Class="OverREALITY.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="ShieldCheck" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{Binding PresentationState.AccentColor}" />
            <TextBlock Text="{Binding PresentationState.Title}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PresentationState.Subtitle}" FontSize="16" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,32" />
            
            <ProgressBar IsIndeterminate="True" Visibility="{Binding PresentationState.IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,32" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding ConnectCommand}" Content="CONNECT" Margin="0,0,16,0" Width="120" />
                <Button Command="{Binding DisconnectCommand}" Content="DISCONNECT" Width="120" Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
