{
  "log": {
    "level": "debug",
    "output": "{{LOG_PATH}}",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "address": "udp://8.8.8.8",
        "detour": "direct"
      },
      {
        "tag": "remote-fallback",
        "address": "udp://9.9.9.9",
        "detour": "direct"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {{TUN_INBOUND}}
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "{{SERVER_IP}}",
      "server_port": 443,
      "uuid": "{{VPN_UUID}}",
      "flow": "",
      "packet_encoding": "",
      "tls": {
        "enabled": true,
        "server_name": "{{VPN_SNI}}",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "{{VPN_PUBLIC_KEY}}",
          "short_id": "{{VPN_SHORT_ID}}"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "port": [443],
        "network": ["udp"],
        "outbound": "block"
      },
      {
        "port": [53],
        "outbound": "direct"
      },
      {
        "domain": ["api.reviewbook.biz"],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "auto_detect_interface": false,
    "final": "proxy"
  }
}
