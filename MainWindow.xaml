<Window
    x:Class="RealityTunnel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stealthy">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Drag handle: top bar -->
        <Grid x:Name="TitleBar" Height="32" VerticalAlignment="Top"
              Background="Transparent" PointerPressed="TitleBar_PointerPressed">
            <TextBlock Text="Stealthy" VerticalAlignment="Center"
                       Margin="12,0" FontSize="11" Opacity="0.5"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <!-- Minimise to tray -->
            <Button x:Name="MinimiseButton" Content="⊟" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,4,0"
                    Background="Transparent" BorderBrush="Transparent" FontSize="14"
                    Click="MinimiseButton_Click" />
        </Grid>

        <!-- Main content area for Panels -->
        <Grid x:Name="RootPanelHost" Margin="12,40,12,12">
            
            <!-- SPLASH PANEL -->
            <Grid x:Name="SplashPanel" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="48" Height="48" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Checking session..." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- LOGIN PANEL -->
            <StackPanel x:Name="LoginPanel" Visibility="Collapsed" Orientation="Vertical" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Welcome to Stealthy" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                
                <TextBox x:Name="AccountIdBox" PlaceholderText="Account ID" FontSize="13" Background="#18FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="8" />
                <PasswordBox x:Name="MasterTokenBox" PlaceholderText="Master Token" FontSize="13" Background="#18FFFFFF" BorderBrush="#30FFFFFF" CornerRadius="8" />
                
                <CheckBox x:Name="RememberDeviceCheckBox" Content="Remember this device" IsChecked="True" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                
                <Button x:Name="LoginActionBtn" Content="Log In" HorizontalAlignment="Stretch" CornerRadius="8" Background="#CC0078D4" Foreground="White" BorderBrush="Transparent" Padding="0,10" Click="LoginActionBtn_Click" />
            </StackPanel>

            <!-- PROFILE PANEL -->
            <StackPanel x:Name="ProfilePanel" Visibility="Collapsed" Orientation="Vertical" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Profile" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                
                <Border Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ProfilePlanText" Text="Plan: Basic" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ProfileDevicesText" Text="Devices: 1 / 5" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                
                <Button Content="Manage Devices" HorizontalAlignment="Stretch" CornerRadius="8" Background="#22FFFFFF" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderBrush="#30FFFFFF" Padding="0,10" Click="ManageDevices_Click" />
                <Button Content="Log Out" HorizontalAlignment="Stretch" CornerRadius="8" Background="#44FF0000" Foreground="White" BorderBrush="Transparent" Padding="0,10" Click="Logout_Click" />
                
                <Button Content="Back" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Click="BackToMain_Click" />
            </StackPanel>

            <!-- SAVE MASTER TOKEN PANEL -->
            <StackPanel x:Name="SaveMasterTokenPanel" Visibility="Collapsed" Orientation="Vertical" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Save Your Master Token" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="This token is generated once and will never be shown again. Save it securely." TextWrapping="Wrap" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                
                <Border Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock x:Name="SaveMasterTokenText" Text="xoxb-..." FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                </Border>
                
                <Button Content="I have saved it" HorizontalAlignment="Stretch" CornerRadius="8" Background="#CC0078D4" Foreground="White" BorderBrush="Transparent" Padding="0,10" Click="SaveMasterTokenDone_Click" />
            </StackPanel>

            <!-- MAIN VPN PANEL -->
            <StackPanel x:Name="MainVpnPanel" Visibility="Collapsed" Orientation="Vertical" Spacing="10">
                <Grid>
                    <TextBlock x:Name="AutoUpdateBanner" Text="Update available!" FontSize="11" Foreground="#0078D4" HorizontalAlignment="Center" Visibility="Collapsed" />
                    <Button Content="👤" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" FontSize="16" Margin="0,-4,0,0" Click="GoToProfile_Click" />
                </Grid>

            <!-- Status orb + label -->
            <Grid HorizontalAlignment="Center">
                <Ellipse x:Name="StatusOrb" Width="64" Height="64"
                         Fill="#33FFFFFF" />
                <Ellipse x:Name="StatusOrbGlow" Width="48" Height="48"
                         Fill="#44808080" />
                <TextBlock x:Name="StatusIcon" Text="●" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#80808080" />
            </Grid>

            <TextBlock x:Name="StatusLabel" Text="Disconnected"
                       HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="TimerLabel" Text="" HorizontalAlignment="Center"
                       FontSize="11" Opacity="0.55"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- Divider -->
            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,2" />

            <!-- Server IP -->
            <TextBlock Text="SERVER IP" FontSize="10" Opacity="0.5" Margin="0,2,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBox x:Name="ServerIpTextBox"
                     PlaceholderText="e.g. 1.2.3.4"
                     FontSize="13"
                     Background="#18FFFFFF"
                     BorderBrush="#30FFFFFF"
                     CornerRadius="8" />

            <!-- Connect / Disconnect -->
            <Button x:Name="ConnectButton" Content="Connect"
                    HorizontalAlignment="Stretch" Click="ConnectButton_Click"
                    CornerRadius="8" FontWeight="SemiBold" FontSize="13"
                    Background="#CC0078D4" Foreground="White"
                    BorderBrush="Transparent" Padding="0,10" />

            <Button x:Name="DisconnectButton" Content="Disconnect"
                    HorizontalAlignment="Stretch" Click="DisconnectButton_Click"
                    IsEnabled="False" CornerRadius="8" FontSize="13"
                    Background="#22FFFFFF" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    BorderBrush="#30FFFFFF" Padding="0,10" />

            <!-- Dashboard stats -->
            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,2" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="EXIT IP"
                           FontSize="9" Opacity="0.45" Margin="0,0,0,2"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="STATUS"
                           FontSize="9" Opacity="0.45" Margin="8,0,0,2"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ExitIpLabel" Grid.Column="0" Grid.Row="1"
                           Text="—" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="RetryLabel" Grid.Column="1" Grid.Row="1"
                           Text="—" FontSize="11" Margin="8,0,0,0"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
